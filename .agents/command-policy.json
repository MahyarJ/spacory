{
  "allow": [
    ["npm", "run"],
    ["npm", "test"],
    ["npm", "ci"],
    ["npm", "install"],
    ["npm", "i"],
    ["npx", "tsc"],
    ["npx", "@biomejs/biome"],
    ["npx", "vitest"],
    ["git", "status"],
    ["git", "diff"],
    ["git", "log"],
    ["git", "show"],
    ["git", "branch"],
    ["git", "switch"],
    ["git", "checkout"],
    ["git", "merge"],
    ["git", "add"],
    ["git", "commit"],
    ["git", "fetch"],
    ["git", "pull"],
    ["git", "push"],
    ["git", "restore"],
    ["git", "rev-parse"],
    ["git", "ls-files"],
    ["git", "ls-remote"],
    ["gh", "pr"],
    ["gh", "run"],
    ["gh", "issue"],
    ["gh", "repo", "view"],
    ["gh", "api"],
    [".agents/notify.sh"]
  ],
  "deny": [
    ["git", "push", "--force"],
    ["git", "push", "-f"],
    ["git", "push", "--force-with-lease"],
    ["git", "push", "--delete"],
    ["git", "push", "-d"],
    ["git", "reset", "--hard"],
    ["git", "filter-branch"],
    ["rm", "-rf"]
  ]
}
