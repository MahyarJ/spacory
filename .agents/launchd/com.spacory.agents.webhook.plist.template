<?xml version="1.0" encoding="UTF-8"?>
<!-- Render with install.sh. The receiver exits normally if no secret is configured. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spacory.agents.webhook</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/.agents/dispatch.sh</string>
    <string>webhook</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/.agents/logs/webhook.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/.agents/logs/webhook.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
